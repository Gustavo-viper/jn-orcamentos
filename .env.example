# ============================================================
# J&N Orçamentos — variáveis de ambiente do servidor
# Copie para server/.env e preencha. Nunca versione o .env.
# ============================================================

# --- Banco de dados (PRODUÇÃO: obrigatório) ---
# PostgreSQL 14+. Sem esta variável o servidor usa PGlite (PostgreSQL embutido)
# gravado em DATA_DIR — indicado apenas para uso local / testes.
DATABASE_URL=postgres://usuario:senha@host:5432/jn_orcamentos

# --- Aplicação ---
NODE_ENV=production
PORT=3001
# Endereço público do sistema (usado nos links de redefinição de senha)
APP_URL=https://orcamentos.seudominio.com.br
# true quando servido via HTTPS (cookies seguros + HSTS). Padrão: true em produção.
COOKIE_SECURE=true
# true se estiver atrás de proxy reverso (Nginx, Render, Railway, Fly.io...)
TRUST_PROXY=true
# Duração da sessão em dias
SESSION_DAYS=30

# --- Armazenamento local do servidor ---
# DATA_DIR=./data            # somente quando usar PGlite
# BACKUP_DIR=./backups       # backups .json.gz (use um disco persistente!)
AUTO_BACKUP_HOURS=24          # 0 desativa o backup automático
BACKUP_KEEP=30                # backups automáticos mantidos

# --- E-mail (recuperação de senha) — opcional ---
# Sem SMTP, o link de redefinição é impresso no log do servidor e o
# administrador pode redefinir senhas em Configurações → Usuários.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=J&N Orçamentos <nao-responda@seudominio.com.br>
